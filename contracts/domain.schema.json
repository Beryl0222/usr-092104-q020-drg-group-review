{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "病种付费归组复核领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "CASE_SIGNED",
        "GROUP_PROPOSED",
        "REVIEW_REQUESTED",
        "DECISION_ISSUED",
        "SETTLEMENT_ADJUSTED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "rule_package",
        "inpatient_case",
        "grouping_candidate",
        "settlement_decision"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
